@startuml SynapsePortal_UseCaseDiagram

skinparam actorStyle awesome
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #555555
  BorderThickness 1
  FontSize 11
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontSize 11
}

skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #333333
  BorderThickness 1.5
  FontSize 13
  FontStyle bold
}

skinparam dpi 180
left to right direction

' ACTORS

actor "Student" as S
actor "Graduate\nStudent" as GS
actor "Teacher" as T
actor "Researcher" as R
actor "Manager" as M
actor "Admin" as A
actor "TechSupport\nSpecialist" as TS

' GraduateStudent is a Student AND a Researcher
GS --|> S
GS --|> R

' SYSTEM BOUNDARY

rectangle "Synapse Portal - University Management System" {

  ' AUTH
  package "Authentication" {
    usecase "Login / Logout" as LOGIN
    usecase "Hash password" as HASH
  }
  LOGIN ..> HASH : <<include>>

  ' STUDENT
  package "Student" {
    usecase "View available courses\n(MAJOR / MINOR / FREE ELECTIVE)" as S1
    usecase "Register for course" as S2
    usecase "View teacher info\nfor a course" as S3
    usecase "View marks\n(att1 + att2 + final)" as S4
    usecase "View transcript" as S5
    usecase "Get transcript (.txt)" as S6
    usecase "View attendance (%)" as S7
    usecase "View schedule" as S8
    usecase "Rate teacher (1-5)" as S9
    usecase "Join / lead\nstudent organization" as S10
    usecase "Subscribe to journal\n& get notifications" as S11

    usecase "Check credit limit\n<= 21 credits" as S2a
    usecase "Check fail limit\n<= 3 attempts" as S2b
  }

  S2 ..> S2a : <<include>>
  S2 ..> S2b : <<include>>

  ' TEACHER
  package "Teacher" {
    usecase "View own courses" as T1
    usecase "Manage course\n(add / edit lessons)" as T2
    usecase "Put marks\n(att1, att2, final)" as T3
    usecase "Mark attendance" as T4
    usecase "View students &\nstudent info" as T5
    usecase "Send message\nto employee" as T6
    usecase "Send complaint\nto Dean (LOW/MED/HIGH)" as T7
    usecase "Generate course\nperformance report" as T8
  }

  ' RESEARCHER
  package "Researcher" {
    usecase "Add research paper\n(title, authors, doi...)" as R1
    usecase "Calculate h-index" as R2
    usecase "Print / sort papers\n(date / citations / pages)" as R3
    usecase "Get citation\n(Plain Text / BibTeX)" as R4
    usecase "Create / join\nresearch project" as R5
    usecase "Publish paper" as R6

    usecase "Check h-index >= 3\n(supervisor role)" as R2a
    usecase "Auto-generate News" as R6a
    usecase "Notify journal\nsubscribers (Observer)" as R6b
    usecase "Pin Research\nnews automatically" as R6c
  }

  R2 ..> R2a : <<include>>
  R6 ..> R6a : <<include>>
  R6a ..> R6b : <<include>>
  R6a ..> R6c : <<include>>

  ' MANAGER
  package "Manager" {
    usecase "Assign teacher\nto course" as M1
    usecase "Approve / reject\nstudent registration" as M2
    usecase "Add course\n(school + year of study)" as M3
    usecase "Generate statistics\nreport" as M4
    usecase "Manage news\n(create / edit / delete)" as M5
    usecase "View students by school\n& filter by department" as M6
    usecase "View students sorted\nby GPA / alphabetically" as M7
    usecase "View teachers\nby school" as M8
    usecase "View employee requests\n(signed by Dean/Rector)" as M9
  }

  ' ADMIN
  package "Admin" {
    usecase "Add user" as A1
    usecase "Remove user" as A2
    usecase "Update user" as A3
    usecase "View system logs" as A4
    usecase "Ban / unban user" as A5
    usecase "Reset password" as A6
    usecase "Manage roles" as A7
  }

  ' TECH SUPPORT
  package "TechSupport" {
    usecase "View new requests\n(NEW -> VIEWED)" as TS1
    usecase "Accept request\n(VIEWED -> ACCEPTED)" as TS2
    usecase "Reject request\n(VIEWED -> REJECTED)" as TS3
    usecase "Complete request\n(ACCEPTED -> DONE)" as TS4
  }

  ' SYSTEM AUTO (no actor)
  package "System (auto)" {
    usecase "Serialize Database\non exit" as SYS1
    usecase "Deserialize Database\non startup" as SYS2
  }

}

' CONNECTIONS

' Auth
S  --> LOGIN
T  --> LOGIN
M  --> LOGIN
A  --> LOGIN
TS --> LOGIN

' Student
S --> S1
S --> S2
S --> S3
S --> S4
S --> S5
S --> S6
S --> S7
S --> S8
S --> S9
S --> S10
S --> S11

' Teacher
T --> T1
T --> T2
T --> T3
T --> T4
T --> T5
T --> T6
T --> T7
T --> T8

' Researcher
R --> R1
R --> R2
R --> R3
R --> R4
R --> R5
R --> R6

' Manager
M --> M1
M --> M2
M --> M3
M --> M4
M --> M5
M --> M6
M --> M7
M --> M8
M --> M9

' Admin
A --> A1
A --> A2
A --> A3
A --> A4
A --> A5
A --> A6
A --> A7

' TechSupport
TS --> TS1
TS --> TS2
TS --> TS3
TS --> TS4

@enduml
